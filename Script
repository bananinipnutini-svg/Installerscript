-- нижний регистр с поддержкой кириллицы (ё -> е)
local function lowerU(s)
	s = tostring(s or "")
	local ok, res = pcall(function()
		local out = {}
		for _, cp in utf8.codes(s) do
			if cp >= 0x410 and cp <= 0x42F then
				cp = cp + 32
			elseif cp == 0x401 or cp == 0x451 then
				cp = 0x435
			elseif cp >= 0x400 and cp <= 0x40F then
				cp = cp + 80
			elseif cp >= 65 and cp <= 90 then
				cp = cp + 32
			end
			out[#out + 1] = utf8.char(cp)
		end
		return table.concat(out)
	end)
	if ok then return res end
	return string.lower(s)
end

local function trim(s)
	return string.match(tostring(s or ""), "^%s*(.-)%s*$")
end

local connections = {}
local function connect(signal, fn)
	local c = signal:Connect(fn)
	table.insert(connections, c)
	return c
end

-- new("Frame", { BackgroundColor3 = "@bg" })  ->  цвет берётся из темы и меняется вместе с ней
local function new(class, props, parent)
	local inst = Instance.new(class)
	for k, v in pairs(props or {}) do
		if type(v) == "string" and v:sub(1, 1) == "@" then
			local key = v:sub(2)
			inst[k] = THEME[key]
			table.insert(bindings, { inst = inst, prop = k, key = key })
		else
			inst[k] = v
		end
	end
	if parent then inst.Parent = parent end
	return inst
end

local function tween(obj, t, props, style, dir)
	local tw = TweenService:Create(
		obj,
		TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out),
		props
	)
	tw:Play()
	return tw
end

local function corner(parent, r)
	return new("UICorner", { CornerRadius = UDim.new(0, r) }, parent)
end

local function roundCorner(parent)
	return new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, parent)
