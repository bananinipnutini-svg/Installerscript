	mark(UDim2.fromScale(0.86, 0.5), UDim2.fromOffset(8, 2))
	mark(UDim2.fromScale(0.5, 0.5), UDim2.fromOffset(2, 2))
	Cross.holder = holder
end

function ESP.getObject(plr)
	local o = ESP.objects[plr]
	if o then return o end
	o = {
		line = new("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			BackgroundColor3 = Color3.new(1, 1, 1),
			BorderSizePixel = 0,
			Visible = false,
		}, espLayer),
		label = new("TextLabel", {
			AnchorPoint = Vector2.new(0.5, 1),
			Size = UDim2.fromOffset(180, 14),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			TextSize = 12,
			TextStrokeTransparency = 0.4,
			TextStrokeColor3 = Color3.new(0, 0, 0),
			Visible = false,
		}, espLayer),
	}
	ESP.objects[plr] = o
	return o
end

function ESP.hideAll()
	for _, o in pairs(ESP.objects) do
		o.line.Visible = false
		o.label.Visible = false
	end
end

local chamFolder = new("Folder", { Name = "Chams" }, gui)

connect(Players.PlayerRemoving, function(plr)
	local o = ESP.objects[plr]
	if o then
		o.line:Destroy()
		o.label:Destroy()
		ESP.objects[plr] = nil
	end
	local h = Cham.objects[plr]
	if h then
		h:Destroy()
		Cham.objects[plr] = nil
	end
end)

local function targetPosition(char, kind)
	if kind == "Head" then
		local h = char:FindFirstChild("Head")
		return h and h.Position
	end
	local r = char:FindFirstChild("HumanoidRootPart")
	if not r then return nil end
	if kind == "Feet" then return r.Position - Vector3.new(0, 3, 0) end
	return r.Position
end

function ESP.update(cam, t)
	if not ESP.enabled then
		if ESP.wasOn then
			ESP.wasOn = false
			ESP.hideAll()
		end
		return
	end
	ESP.wasOn = true

	local vp = cam.ViewportSize
	local origin
	if ESP.origin == "Center" then
		origin = vp / 2
	elseif ESP.origin == "Top" then
		origin = Vector2.new(vp.X / 2, 0)
	else
		origin = Vector2.new(vp.X / 2, vp.Y)
	end

	local _, myRoot = getChar()
	local myPos = myRoot and myRoot.Position or cam.CFrame.Position
	local idx = 0

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			idx = idx + 1
			local o = ESP.getObject(plr)
			local show = false
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local pos = (hum and hum.Health > 0) and targetPosition(char, ESP.target) or nil

			if pos and isEnemy(plr, ESP.teamCheck) then
				local dist = (pos - myPos).Magnitude
				if ESP.maxDist >= DIST_MAX or dist <= ESP.maxDist then
					local v = cam:WorldToViewportPoint(pos)
					if v.Z > 0 then
						show = true
						local p2 = Vector2.new(v.X, v.Y)
						local d = p2 - origin
						local col = ESP.pickColor(ESP.color, plr, t, idx)

						local line = o.line
						line.Size = UDim2.fromOffset(d.Magnitude, ESP.thickness)
						line.Position = UDim2.fromOffset((origin.X + p2.X) / 2, (origin.Y + p2.Y) / 2)
						line.Rotation = math.deg(math.atan2(d.Y, d.X))
						line.BackgroundColor3 = col
						line.BackgroundTransparency = 1 - ESP.opacity

						-- имя / дистанция / здоровье
						local label = o.label
						local showText = (ESP.names or ESP.distance or ESP.health)
							and p2.X > 0 and p2.X < vp.X and p2.Y > 0 and p2.Y < vp.Y
						if showText then
							local parts = {}
							if ESP.names then table.insert(parts, plr.DisplayName) end
							if ESP.distance then table.insert(parts, "[" .. math.floor(dist) .. "]") end
							if ESP.health then table.insert(parts, math.floor(hum.Health) .. "hp") end
							label.Text = table.concat(parts, "  ")
							label.TextColor3 = col
							label.Position = UDim2.fromOffset(p2.X, p2.Y - 8)
						end
						label.Visible = showText
					end
				end
			end

			o.line.Visible = show
			if not show then o.label.Visible = false end
		end
	end
end

-- Chams: подсветка игроков сквозь стены (Highlight)
function Cham.update(t)
	if not Cham.enabled then
		if Cham.wasOn then
			Cham.wasOn = false
			for _, h in pairs(Cham.objects) do h.Enabled = false end
		end
		return
	end
	Cham.wasOn = true
	local idx = 0
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer then
			idx = idx + 1
			local h = Cham.objects[plr]
			if not h then
				h = Instance.new("Highlight")
				h.Name = "Cham"
				h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
				h.Parent = chamFolder
				Cham.objects[plr] = h
			end
			local char = plr.Character
			if char and isEnemy(plr, Cham.teamCheck) then
				local col = ESP.pickColor(ESP.color, plr, t, idx)
				h.Adornee = char
				h.FillColor = col
				h.OutlineColor = col:Lerp(Color3.new(1, 1, 1), 0.35)
				h.FillTransparency = Cham.fill
				h.OutlineTransparency = Cham.outline and 0 or 1
				h.Enabled = true
			else
				h.Enabled = false
			end
		end
	end
end

local aimParams = RaycastParams.new()
aimParams.FilterType = Enum.RaycastFilterType.Exclude

local function aimPartOf(char)
	if Aim.part == "Head" then return char:FindFirstChild("Head") end
	return char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("UpperTorso")
		or char:FindFirstChild("Torso")
end

function Aim.update(cam, dt)
	Aim.circle.Visible = Aim.enabled and Aim.showFov
	if not Aim.enabled then return end
	if Aim.mode == "Hold RMB" and not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		return
	end

	local center = cam.ViewportSize / 2
	local camPos = cam.CFrame.Position
	local bestPart, bestD
	aimParams.FilterDescendantsInstances = { LocalPlayer.Character }

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LocalPlayer and isEnemy(plr, Aim.teamCheck) then
			local char = plr.Character
			local hum = char and char:FindFirstChildOfClass("Humanoid")
			local part = char and aimPartOf(char)
			if hum and hum.Health > 0 and part then
				local v = cam:WorldToViewportPoint(part.Position)
				if v.Z > 0 then
					local d = (Vector2.new(v.X, v.Y) - center).Magnitude
					if d <= Aim.fov and (not bestD or d < bestD) then
						local ok = true
						if Aim.maxDist < DIST_MAX then
							ok = (part.Position - camPos).Magnitude <= Aim.maxDist
						end
						if ok and Aim.wallCheck then
							local res = workspace:Raycast(camPos, part.Position - camPos, aimParams)
							ok = (res == nil) or res.Instance:IsDescendantOf(char)
						end
						if ok then
							bestPart, bestD = part, d
						end
					end
				end
			end
		end
	end

	if bestPart then
		local cf = cam.CFrame
		local goal = CFrame.lookAt(cf.Position, bestPart.Position)
		local s = math.clamp(Aim.smooth / 100, 0, 0.97)
		local alpha = 1 - s ^ (dt * 60)
		cam.CFrame = cf:Lerp(goal, alpha)
	end
end

-- Выполняется после обновления камеры, чтобы аим не перебивался
RunService:BindToRenderStep("InstallerScripts_Main", Enum.RenderPriority.Camera.Value + 1, function(dt)
	local cam = workspace.CurrentCamera
	if not cam then return end
	local t = os.clock()
	ESP.update(cam, t)
	Cham.update(t)
	Aim.update(cam, dt)
	F.applyWorld()
end)
